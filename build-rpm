#!/usr/bin/env bash

# ============================================================
# Simple one-step RPM package builder for Bash scripts
#
# Usage:
#   ./build_rpm.sh <your_script.sh> [package_name]
#
# Example:
#   ./build_rpm.sh myscript.sh mytool
#
# Output:
#   mytool-1.0-1.noarch.rpm
# ============================================================

set -euo pipefail

# ------------------------------------------------------------
# Arguments
# ------------------------------------------------------------

if [ $# -lt 1 ]; then
    echo "Usage: $0 <bash_script> [package_name]"
    echo "Example: $0 myscript.sh mytool"
    exit 1
fi

SCRIPT_PATH="$1"
SCRIPT_NAME="$(basename "$SCRIPT_PATH")"

PACKAGE_NAME="${2:-${SCRIPT_NAME%.*}}"

VERSION="1.0"
RELEASE="1"

ARCHITECTURE="noarch"

MAINTAINER="${USER:-KYGnus}"

SUMMARY="$SCRIPT_NAME"
DESCRIPTION="Automated RPM package for $SCRIPT_NAME."

# ------------------------------------------------------------
# Validate source script
# ------------------------------------------------------------

if [ ! -f "$SCRIPT_PATH" ]; then
    echo "❌ Error: Script not found: $SCRIPT_PATH"
    exit 1
fi

if [ ! -r "$SCRIPT_PATH" ]; then
    echo "❌ Error: Script is not readable: $SCRIPT_PATH"
    exit 1
fi

# ------------------------------------------------------------
# Check rpmbuild
# ------------------------------------------------------------

if ! command -v rpmbuild >/dev/null 2>&1; then
    echo "❌ Error: rpmbuild is not installed."
    echo
    echo "openSUSE:"
    echo "  sudo zypper install rpm-build"
    echo
    echo "Fedora/RHEL/Rocky/Alma:"
    echo "  sudo dnf install rpm-build"
    exit 1
fi

# ------------------------------------------------------------
# Temporary build directory
# ------------------------------------------------------------

TEMP_DIR="$(mktemp -d /tmp/rpm_build_XXXXXX)"

cleanup() {
    rm -rf "$TEMP_DIR"
}

trap cleanup EXIT

# ------------------------------------------------------------
# RPM build tree
# ------------------------------------------------------------

RPM_TOP="$TEMP_DIR/rpmbuild"

mkdir -p \
    "$RPM_TOP/BUILD" \
    "$RPM_TOP/BUILDROOT" \
    "$RPM_TOP/RPMS" \
    "$RPM_TOP/SOURCES" \
    "$RPM_TOP/SPECS" \
    "$RPM_TOP/SRPMS"

# ------------------------------------------------------------
# Source directory
# ------------------------------------------------------------

SOURCE_DIR="${PACKAGE_NAME}-${VERSION}"

SOURCE_TMP="$TEMP_DIR/$SOURCE_DIR"

mkdir -p "$SOURCE_TMP"

# ------------------------------------------------------------
# Copy script
# ------------------------------------------------------------

echo "📄 Preparing script: $SCRIPT_NAME"

cp "$SCRIPT_PATH" "$SOURCE_TMP/$PACKAGE_NAME"

chmod 0755 "$SOURCE_TMP/$PACKAGE_NAME"

# ------------------------------------------------------------
# Ensure Bash shebang
# ------------------------------------------------------------

if ! head -n 1 "$SOURCE_TMP/$PACKAGE_NAME" | grep -q '^#!'; then
    echo "🔧 No shebang detected. Adding #!/bin/bash"

    TEMP_SCRIPT="$SOURCE_TMP/${PACKAGE_NAME}.tmp"

    {
        echo '#!/bin/bash'
        cat "$SOURCE_TMP/$PACKAGE_NAME"
    } > "$TEMP_SCRIPT"

    mv "$TEMP_SCRIPT" "$SOURCE_TMP/$PACKAGE_NAME"

    chmod 0755 "$SOURCE_TMP/$PACKAGE_NAME"
fi

# ------------------------------------------------------------
# Create source archive
# ------------------------------------------------------------

echo "📦 Creating source archive..."

tar \
    -C "$TEMP_DIR" \
    -czf "$RPM_TOP/SOURCES/${SOURCE_DIR}.tar.gz" \
    "$SOURCE_DIR"

# ------------------------------------------------------------
# Create SPEC file
# ------------------------------------------------------------

SPEC_FILE="$RPM_TOP/SPECS/${PACKAGE_NAME}.spec"

echo "📝 Creating RPM spec file..."

cat > "$SPEC_FILE" << EOF
Name:           $PACKAGE_NAME
Version:        $VERSION
Release:        $RELEASE%{?dist}
Summary:        $SUMMARY

License:        MIT
BuildArch:      $ARCHITECTURE

Source0:        %{name}-%{version}.tar.gz

Requires:       bash

%description
$DESCRIPTION

%prep
%setup -q

%build
# Bash script - no compilation required.

%install

mkdir -p %{buildroot}%{_bindir}

install -m 0755 \
    $PACKAGE_NAME \
    %{buildroot}%{_bindir}/$PACKAGE_NAME

%files
%{_bindir}/$PACKAGE_NAME

%changelog
* $(date "+%a %b %d %Y") $MAINTAINER - $VERSION-$RELEASE
- Initial RPM package
- Packaged $SCRIPT_NAME
EOF

# ------------------------------------------------------------
# Build RPM
# ------------------------------------------------------------

echo "📦 Building RPM package..."

rpmbuild \
    --define "_topdir $RPM_TOP" \
    -bb "$SPEC_FILE"

# ------------------------------------------------------------
# Locate generated RPM
# ------------------------------------------------------------

RPM_FILE="$(find "$RPM_TOP/RPMS" \
    -type f \
    -name "${PACKAGE_NAME}-${VERSION}-${RELEASE}*.rpm" \
    ! -name "*.src.rpm" \
    | head -n 1)"

if [ -z "$RPM_FILE" ]; then
    echo "❌ Error: RPM package was not generated."
    exit 1
fi

OUTPUT_RPM="$(pwd)/$(basename "$RPM_FILE")"

cp "$RPM_FILE" "$OUTPUT_RPM"

# ------------------------------------------------------------
# Package information
# ------------------------------------------------------------

echo
echo "============================================================"
echo "✅ RPM PACKAGE CREATED SUCCESSFULLY"
echo "============================================================"
echo
echo "📦 Package:"
echo "   $OUTPUT_RPM"
echo
echo "📊 Package information:"
echo

rpm -qip "$OUTPUT_RPM"

# ------------------------------------------------------------
# SHA256
# ------------------------------------------------------------

if command -v sha256sum >/dev/null 2>&1; then
    echo
    echo "🔐 SHA256:"
    sha256sum "$OUTPUT_RPM"
fi

# ------------------------------------------------------------
# Installation instructions
# ------------------------------------------------------------

echo
echo "📝 Installation:"
echo
echo "   openSUSE:"
echo "   sudo zypper install ./$OUTPUT_RPM"
echo
echo "   Fedora/RHEL/Rocky/Alma:"
echo "   sudo dnf install ./$OUTPUT_RPM"
echo
echo "📝 Run:"
echo "   $PACKAGE_NAME"
echo
echo "📝 Remove:"
echo "   sudo rpm -e $PACKAGE_NAME"
echo
echo "✅ Done."
